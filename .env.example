# ── LLM Provider ────────────────────────────────────────────────────────────
# Set to "ollama" for local/LAN inference, "groq" for cloud (post-MVP).
LLM_PROVIDER=ollama

# ── Ollama (used when LLM_PROVIDER=ollama) ──────────────────────────────────
# Address reachable from inside the Docker container.
# For Ollama running on this same Linux host, use host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
EMOTION_MODEL=http://host.docker.internal:11434/qwen2.5:32b-instruct
# Model must be pulled on the Ollama machine: `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b

# ── Groq (used when LLM_PROVIDER=groq, post-MVP) ────────────────────────────
GROQ_API_KEY=

# ── FFmpeg Overlay Service ───────────────────────────────────────────────────
# Maximum video upload size in megabytes.
MAX_UPLOAD_SIZE_MB=500
