# ── LLM Provider ────────────────────────────────────────────────────────────
# Set to "ollama" for local/LAN inference, "groq" for cloud (post-MVP).
LLM_PROVIDER=ollama

# ── Ollama (used when LLM_PROVIDER=ollama) ──────────────────────────────────
# Address reachable from inside the Docker container.
# For Ollama running on this same Linux host, use host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
# Model name only (not a URL) — must be pulled on the Ollama machine, e.g. `ollama pull qwen2.5:32b-instruct`
EMOTION_MODEL=qwen2.5:32b-instruct
# Model must be pulled on the Ollama machine: `ollama pull llama3.1:8b`
OLLAMA_MODEL=qwen2.5:32b-instruct

# ── Groq (used when LLM_PROVIDER=groq, post-MVP) ────────────────────────────
GROQ_API_KEY=

# ── FFmpeg Overlay Service ───────────────────────────────────────────────────
# Maximum video upload size in megabytes.
MAX_UPLOAD_SIZE_MB=500

# ── Media Ingest Service ─────────────────────────────────────────────────────
# LAN addresses of the host-based Whisper STT and Pyannote diarization services.
WHISPER_URL=http://192.168.1.188:5000
PYANNOTE_URL=http://192.168.1.188:3003
# Number of speakers to force during diarization.
NUM_SPEAKERS=2
