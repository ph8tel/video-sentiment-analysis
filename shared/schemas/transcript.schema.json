{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transcript",
  "description": "Chunked transcript with timestamps, supplied by the user.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["start", "end", "text"],
    "additionalProperties": false,
    "properties": {
      "start": {
        "type": "number",
        "minimum": 0,
        "description": "Chunk start time in seconds."
      },
      "end": {
        "type": "number",
        "minimum": 0,
        "description": "Chunk end time in seconds. Must be greater than start."
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "description": "Spoken text for this chunk."
      }
    }
  }
}
