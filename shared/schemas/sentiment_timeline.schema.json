{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentimentTimeline",
  "description": "Central data contract shared by the FFmpeg overlay service and the dashboard.",
  "type": "object",
  "required": ["chunks", "overall"],
  "additionalProperties": false,
  "definitions": {
    "tone": {
      "type": "string",
      "enum": [
        "VERY_NEGATIVE",
        "NEGATIVE",
        "SLIGHTLY_NEGATIVE",
        "NEUTRAL",
        "SLIGHTLY_POSITIVE",
        "POSITIVE",
        "VERY_POSITIVE"
      ]
    }
  },
  "properties": {
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end", "tone", "score", "color", "text", "anger_level", "frustration_level", "sarcasm_flag"],
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Chunk start time in seconds."
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "Chunk end time in seconds."
          },
          "tone": {
            "$ref": "#/definitions/tone",
            "description": "Sentiment tone label assigned by the scoring service."
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Numeric sentiment score (0 = very negative, 10 = very positive)."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Hex color mapped from tone."
          },
          "text": {
            "type": "string",
            "description": "Original transcript text for this chunk."
          },
          "anger_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Anger intensity: 0=none (\ud83d\ude10), 1=mild (\ud83d\ude20), 2=strong (\ud83d\ude21), 3=intense (\ud83d\udca5)."
          },
          "frustration_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Frustration intensity: 0=none (\ud83d\ude10), 1=mild (\ud83d\ude24), 2=strong (\ud83d\ude23), 3=intense (\ud83e\udd2c)."
          },
          "sarcasm_flag": {
            "type": "boolean",
            "description": "True when the chunk contains detectable sarcasm or irony."
          }
        }
      }
    },
    "overall": {
      "type": "object",
      "required": ["score", "tone"],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Weighted average sentiment score across all chunks."
        },
        "tone": {
          "$ref": "#/definitions/tone",
          "description": "Tone label derived from the overall score."
        }
      }
    }
  }
}
